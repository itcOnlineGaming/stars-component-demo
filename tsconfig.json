{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist",
		"allowJs": true,
		"checkJs": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"target": "ES2022",
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	"exclude": ["node_modules/**", "dist/**", "build/**"]
}
